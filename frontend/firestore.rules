rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;                    // Needed to find members by email
      allow create, update: if request.auth.uid == uid;       // Only you edit your profile
    }
    match /trips/{tripId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /messages/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/trips/$(tripId)).data.memberIds;
      }
    }
  }
}